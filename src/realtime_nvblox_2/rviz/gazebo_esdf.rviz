Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: base_link
    Background Color: 35; 35; 35
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Camera RGB
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: Camera Depth
      Enabled: false
      Topic:
        Value: /camera/depth/image_rect_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Transport Hint: raw
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.15
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF observed
      Enabled: true
      Topic:
        Value: /realtime_nvblox/esdf_observed
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 3
      Position Transformer: XYZ
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF all observed voxels
      Enabled: false
      Topic:
        Value: /realtime_nvblox/esdf_3d
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Position Transformer: XYZ
      Color Transformer: RGB8
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Pitch: 0.6
      Yaw: 0.8
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.5}
Window Geometry:
  Width: 1280
  Height: 800
