#!/usr/bin/python3
"""Verify a running Gazebo planning loop and, optionally, send a second target."""
import argparse
import json
import math
from pathlib import Path
import statistics
import time

import rclpy
from geometry_msgs.msg import PoseStamped
from sensor_msgs.msg import JointState
from std_msgs.msg import Float64MultiArray


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--timeout", type=float, default=120)
    parser.add_argument("--threshold", type=float, default=0.02)
    parser.add_argument("--retarget", action="store_true", help="after the default goal, command [0.5, 0.0, 0.45]")
    args = parser.parse_args()
    rclpy.init()
    node = rclpy.create_node("verify_sage_planning")
    ee, joints, commands, command_times = [], [], [], []
    def position(msg):
        p = msg.pose.position
        ee.append([p.x, p.y, p.z])
    subs = [node.create_subscription(PoseStamped, "/ee_pose", position, 10),
            node.create_subscription(JointState, "/joint_states", lambda m: joints.append(list(m.position)), 10),
            node.create_subscription(Float64MultiArray, "/forward_position_controller/commands",
                lambda m: (commands.append(list(m.data)), command_times.append(time.monotonic())), 100)]
    publisher = node.create_publisher(PoseStamped, "/target_pose", 10)
    goals = [[0.4, -0.5, 0.4]] + ([[0.5, 0.0, 0.45]] if args.retarget else [])
    report = {"result": "FAIL", "goals": []}
    try:
        for index, goal in enumerate(goals):
            if index:
                msg = PoseStamped()
                msg.header.frame_id = "world"
                msg.header.stamp = node.get_clock().now().to_msg()
                msg.pose.position.x, msg.pose.position.y, msg.pose.position.z = goal
                msg.pose.orientation.w = 1.0
                publisher.publish(msg)
            deadline = time.monotonic() + args.timeout
            seen, stable = len(ee), 0
            initial_error = None
            error = float("inf")
            while time.monotonic() < deadline:
                rclpy.spin_once(node, timeout_sec=0.1)
                if len(ee) == seen:
                    continue
                seen = len(ee)
                error = math.dist(ee[-1], goal)
                if initial_error is None:
                    initial_error = error
                stable = stable + 1 if error < args.threshold else 0
                if stable >= 10:
                    break
            report["goals"].append({"target_world": goal, "initial_error_m": initial_error,
                "final_error_m": error, "stable_samples_under_threshold": stable})
            if stable < 10:
                raise RuntimeError(f"Goal {goal} failed to settle below {args.threshold} m; final error {error}")
        if len(commands) < 100 or len(joints) < 20:
            raise RuntimeError("Insufficient command or joint feedback messages")
        if any(len(c) != 6 or not all(math.isfinite(x) for x in c) for c in commands):
            raise RuntimeError("Invalid joint commands")
        motion = max(math.dist(joints[0], q) for q in joints if len(q) == len(joints[0]))
        if motion < 0.1:
            raise RuntimeError("No significant measured robot motion")
        intervals = [b-a for a,b in zip(command_times,command_times[1:]) if b>a]
        report.update(result="PASS", joint_motion_l2_rad=motion, command_messages=len(commands),
            joint_state_messages=len(joints), ee_messages=len(ee),
            median_command_rate_hz=1.0/statistics.median(intervals), threshold_m=args.threshold)
    except Exception as exc:
        report["error"] = str(exc)
        raise
    finally:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(report, indent=2) + "\n")
        print(json.dumps(report, indent=2))
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
