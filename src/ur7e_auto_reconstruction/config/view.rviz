Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 35; 35; 40
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Base Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Name: Reconstructed Surface
      Enabled: true
      Topic:
        Value: /ur7e_auto_mapper/mesh
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Reconstructed Vertices
      Enabled: false
      Topic:
        Value: /ur7e_auto_mapper/surface_points
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: false
      Alpha: 0.45
      Description Source: Topic
      Description Topic:
        Value: /ur7e_auto/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Pose
      Name: Depth Camera Pose
      Enabled: true
      Topic:
        Value: /ur7e_auto_mapper/camera_pose
      Shape: Axes
      Axes Length: 0.15
      Axes Radius: 0.01
    - Class: rviz_default_plugins/MarkerArray
      Name: Reviewed Camera Route
      Enabled: true
      Topic:
        Value: /ur7e_auto_scan/route
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.9
      Focal Point: {X: 0.35, Y: -0.45, Z: 0.2}
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 900
