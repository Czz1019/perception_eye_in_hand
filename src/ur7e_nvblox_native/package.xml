  <maintainer email="czz@localhost.localdomain">czz</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nvblox_ros</depend><depend>rclcpp</depend><depend>std_msgs</depend>
