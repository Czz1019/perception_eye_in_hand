<?xml version="1.0"?>
<package format="3">
  <name>ur7e_nvblox_in_hand</name><version>0.1.0</version>
  <description>D435 robot-TF mapping with nvblox_torch and native ESDF export, without Isaac ROS.</description>
  <maintainer email="czz@example.com">czz</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>ur7e_nvblox_interfaces</exec_depend><exec_depend>ur7e_d435_gazebo</exec_depend>
  <exec_depend>rviz2</exec_depend><exec_depend>rosgraph_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
