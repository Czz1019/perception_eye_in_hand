<?xml version="1.0"?>
<package format="3">
  <name>ur7e_sage_planner</name>
  <version>0.1.0</version>
  <description>Clean SAGE MPPI planning and joint servo execution for the UR7e Gazebo scene.</description>
  <maintainer email="wqj@localhost.localdomain">wqj</maintainer>
  <license>MIT</license>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ur7e_d435_gazebo</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- PyTorch/CUDA and storm_kit are supplied by the whole_control conda environment. -->
  <export><build_type>ament_cmake</build_type></export>
</package>
